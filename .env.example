# Bootstrap secrets only. WhatsApp / Anthropic / Stripe keys are entered in
# /admin/settings/integrations and stored encrypted in Postgres.

DATABASE_URL=postgresql://carrental:carrental@localhost:5433/carrental
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=
SESSION_SECRET=

# Production public origin (webhooks, Stripe redirects, local upload URLs)
APP_BASE_URL=https://carrental.myflynai.com
# Vercel injects this automatically when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=
# Optional later replacement: S3-compatible object storage (R2, S3, or MinIO)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

SENTRY_DSN=
