# Bootstrap secrets only. WhatsApp / Anthropic / Stripe keys are entered in
# /admin/settings/integrations and stored encrypted in Postgres.

DATABASE_URL=postgresql://carrental:carrental@localhost:5433/carrental
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=
SESSION_SECRET=

# Production public origin (webhooks, Stripe redirects, local upload URLs)
APP_BASE_URL=https://carrental.myflynai.com

# Vercel Blob — auto-injected on Vercel when a Blob store is connected.
# For local uploads against production Blob, paste the token from Vercel → Storage.
BLOB_READ_WRITE_TOKEN=

# Optional S3-compatible fallback (R2/MinIO) if Blob is not used
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=

SENTRY_DSN=
