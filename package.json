{
  "name": "carrental",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run build:worker && next build",
    "build:worker": "esbuild ./lib/queue/worker.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/worker.mjs --external:@prisma/client --external:ioredis --external:bullmq --external:@sentry/node --external:@anthropic-ai/sdk --external:stripe --external:@aws-sdk/* --external:@node-rs/argon2 --external:jose --external:zod --external:dotenv",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:evidence": "vitest run tests/integration/go-live-evidence.integration.test.ts",
    "worker": "node dist/worker.mjs",
    "worker:dev": "tsx lib/queue/worker.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "generate-keys": "tsx scripts/generate-keys.ts",
    "reencrypt-credentials": "tsx scripts/reencrypt-credentials.ts"
    ,"encrypt-existing-pii": "tsx scripts/encrypt-existing-pii.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.70.0",
    "bullmq": "^6.2.0",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.9",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "esbuild": "^0.28.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
